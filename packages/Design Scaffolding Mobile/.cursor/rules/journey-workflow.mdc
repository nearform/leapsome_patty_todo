            <VStack space="md" className="w-full">
              <HStack space="md" className="items-center justify-between w-full">
                <HStack space="md" className="items-center">
                  <Link href="/prototype">
                    <Button 
                      variant="solid"
                      action="primary"
                      size="sm"
                      className="rounded-full w-8 h-8 p-0"
