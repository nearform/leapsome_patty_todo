                      <ArrowLeft className="w-4 h-4 text-white" />
                    </Button>
                  </Link>
                  <Heading as="h1" size="5xl" className="text-accent">
                    {journey.title}
                  </Heading>
                </HStack>
                 <HStack space="sm" className="items-center">
                  <Link href="/canvas">
                    <Button 
                      variant="outline"
                      action="primary"
                      leftIcon={<MousePointerClick className="w-4 h-4" />}
                      className="rounded-full"
